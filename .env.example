# Copia este archivo como .env en la raíz del repositorio. Nunca subas el .env.
# Todas las variables son opcionales; sin NAN_API_KEY y EXA_API_KEY las evaluaciones usan los ejemplos locales.
# Detalle de cada variable: docs/search.md.

# Modelos (NaN Builders) y búsqueda web (Exa): evaluaciones, pnpm doctor y el servidor de la app de
# escritorio (apps/web/app/api/escritorio), que sin ellas responde 503.
NAN_API_KEY=
EXA_API_KEY=

# Análisis de las entrevistas (apps/ingestion/entrevistas): Gemini transcribe el audio y el vídeo, y busca
# y revisa las fuentes. Necesita facturación activa: el plan gratuito se queda corto.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# preview fuerza los ejemplos locales; live fuerza la búsqueda web.
# SEARCH_MODE=preview

# PostgreSQL opcional (datos del Congreso e informes de evaluación). Valor para `docker compose up -d`:
# DATABASE_URL=postgres://gov:gov@127.0.0.1:5442/gov

# Origen público de la web (URLs canónicas y sitemap), por ejemplo https://tu-dominio.
# APP_ORIGIN=

# Estadísticas de uso en PostHog (UE): la clave del proyecto (phc_…). Sin ella, /api/eventos no envía nada.
# POSTHOG_KEY=

# App de escritorio: servidor con el que habla (por defecto https://reforma-digital.es).
# RD_SERVIDOR=http://localhost:3000
