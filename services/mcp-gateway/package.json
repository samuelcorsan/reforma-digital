{
  "name": "@reforma-digital/mcp-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unified legacy SSE MCP gateway for Reforma Digital public tools",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.9.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
