PORT=8080
HOST=0.0.0.0
UPSTREAM_BASE_URL=https://reforma-digital.es/mcp
UPSTREAM_TIMEOUT_MS=20000
UPSTREAM_MAX_BYTES=4194304
UPSTREAM_RETRIES=1
MAX_SESSIONS=100
MAX_INFLIGHT_TOOLS=25
SSE_HEARTBEAT_MS=15000
# Set for Internet-facing deployments when your MCP client can send headers:
# GATEWAY_TOKEN=replace-with-long-random-token
# Set for browser-based clients (comma-separated exact origins):
# ALLOWED_ORIGINS=https://example.com
# Set when using a known public domain (comma-separated host names):
# ALLOWED_HOSTS=example.up.railway.app
# TRUST_PROXY=true
