{
  "appId": "es.reformadigital.mac",
  "productName": "Reforma Digital",
  "copyright": "Reforma Digital \u00b7 C\u00f3digo abierto con licencia MIT",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": ["out/**", "package.json", "!node_modules/**"],
  "npmRebuild": false,
  "electronLanguages": ["es", "en"],
  "publish": {
    "provider": "generic",
    "url": "https://reforma-digital.es/api/escritorio/actualizaciones"
  },
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["arm64", "x64"] },
      { "target": "zip", "arch": ["arm64", "x64"] }
    ],
    "artifactName": "reforma-digital-${version}-${arch}.${ext}",
    "category": "public.app-category.productivity",
    "icon": "build/icon.icon",
    "identity": "-",
    "extendInfo": {
      "NSHumanReadableCopyright": "Reforma Digital \u00b7 Proyecto independiente, sin vinculaci\u00f3n con la Administraci\u00f3n"
    }
  },
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "artifactName": "reforma-digital-${version}-setup.${ext}",
    "icon": "build/icon.png"
  },
  "linux": {
    "target": [
      { "target": "deb", "arch": ["x64"] },
      { "target": "AppImage", "arch": ["x64"] }
    ],
    "icon": "build/icon.png",
    "executableName": "reforma-digital",
    "artifactName": "reforma-digital-${version}-${arch}.${ext}",
    "syncDesktopName": true,
    "category": "Office",
    "maintainer": "Reforma Digital"
  },
  "deb": {
    "packageName": "reforma-digital",
    "artifactName": "reforma-digital_${version}_${arch}.${ext}"
  },
  "electronFuses": {
    "runAsNode": false,
    "enableCookieEncryption": true,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true,
    "grantFileProtocolExtraPrivileges": false
  },
  "asarUnpack": ["out/modelos/**", "out/node_modules/onnxruntime-web/dist/*.wasm"]
}
