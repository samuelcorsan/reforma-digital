{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/lib/flow.ts"]
    },
    "apps/extension": {
      "entry": ["src/content.ts", "src/popup.tsx"]
    },
    "apps/web": {
      "entry": ["scripts/*.{mjs,ts}"]
    },
    "sites/*": {
      "entry": ["flow.ts"]
    }
  }
}
